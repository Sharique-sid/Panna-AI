{
  "manifest_version": 3,
  "name": "Panna.ai - Quick Capture",
  "version": "1.0.0",
  "description": "Capture notes instantly from anywhere on the web with Panna.ai",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "notifications",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://panna-ai-bice.vercel.app/*",
    "https://*.panna.ai/*",
    "https://iuvvmbtqbaauvtojnxjd.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "oauth2": {
    "client_id": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  }
}

